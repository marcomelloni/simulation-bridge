			<Events>
				<Event>
					<Id>1757623721256</Id>
					<Name><![CDATA[initTimer]]></Name>
					<X>50</X><Y>330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1757623721254</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1757664000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[wpIdx = 0;             // parti dal primo waypoint
x = 0.0; y = 0.0;      // posizione iniziale
theta = 0.0; v = 0.0;  // heading/vel init
soc = 1.0;
// valori iniziali da far conoscere alla sim MATLAB
sendInputLoadKg(10.0);         // carico iniziale (cambia a piacere)
sendInputSpeedCap(speed);      // cap iniziale allineato alla tua 'speed'
double[] _wx = (double[]) wx;
double[] _wy = (double[]) wy;
sendInputTarget(_wx[0], _wy[0]); // primo target = primo waypoint
]]></Action>
				</Event>
				<Event>
					<Id>1757623766900</Id>
					<Name><![CDATA[tick]]></Name>
					<X>50</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1757623766898</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1757664000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[dt]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// --- Lettura waypoint array (wx, wy come double[]) ---
double[] _wx = (double[]) wx;
double[] _wy = (double[]) wy;

// --- LOOP AUTOMATICO ---
// Se non ho un indice valido, riparto dal primo
if (wpIdx < 0 || wpIdx >= _wx.length) {
  wpIdx = 0;

  // Invia subito al client l'input dinamico per MATLAB (nuovo target iniziale)
  String jsonStart = String.format(
    java.util.Locale.US,
    "{\"type\":\"SIM_INPUT\",\"inputs\":{\"target\":{\"x\":%.6f,\"y\":%.6f}}}",
    _wx[wpIdx], _wy[wpIdx]
  );
  sendUDP(jsonStart);
}

// --- Target corrente ---
double tx = _wx[wpIdx], ty = _wy[wpIdx];

// --- Controllo heading unicycle (P) ---
double dx = tx - x, dy = ty - y;
double dist = Math.hypot(dx, dy);
double desired = Math.atan2(dy, dx);

// wrap to pi
double thN = ((theta + Math.PI) % (2*Math.PI)) - Math.PI;
double deN = ((desired + Math.PI) % (2*Math.PI)) - Math.PI;
double e = deN - thN;

// velocità angolare e aggiornamento heading
double omega = 2.0 * e;
theta = thN + omega * dt;

// --- Dinamica velocità molto semplice (1° ordine verso 'speed') ---
double tau_v = 0.4;
v = v + (speed - v) * (dt / tau_v);

// --- Integrazione posizione (anti-overshoot) ---
double step = Math.min(v * dt, dist);
x = x + step * Math.cos(theta);
y = y + step * Math.sin(theta);

// --- Batteria fittizia (consuma anche se fermo un pochino) ---
double base = 0.05;              // consumo base
double dyn  = 0.04 * Math.max(v, 0.0);
soc = Math.max(0.0, soc - (base + dyn) * dt / 2.0);

// --- Telemetria verso il DT (via UDP) ---
sendTelemetry();

// --- Gestione arrivo al waypoint + invio INPUT dinamico per MATLAB ---
if (dist <= tol) {
  int prev = wpIdx;
  wpIdx++;

  // loop sui waypoint
  if (wpIdx >= _wx.length) {
    wpIdx = 0;
  }

  // se l'indice è cambiato, invia un nuovo "target" come SIM_INPUT
  if (wpIdx != prev) {
    String json = String.format(
      java.util.Locale.US,
      "{\"type\":\"SIM_INPUT\",\"inputs\":{\"target\":{\"x\":%.6f,\"y\":%.6f}}}",
      _wx[wpIdx], _wy[wpIdx]
    );
    sendUDP(json);

    // (opzionale) esempi di altri input dinamici:
    // - cambiare il limite velocità quando entri in una zona
    // if (wpIdx == 1) {
    //   String cap = String.format(java.util.Locale.US,
    //     "{\"type\":\"SIM_INPUT\",\"inputs\":{\"speed_cap\":%.6f}}", 0.60);
    //   sendUDP(cap);
    // }
    //
    // - variare il carico
    // if (wpIdx == 0) {
    //   String load = String.format(java.util.Locale.US,
    //     "{\"type\":\"SIM_INPUT\",\"inputs\":{\"load_kg\":%.1f}}", 10.0);
    //   sendUDP(load);
    // }
  }
}
]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1757623657470</Id>
					<Name><![CDATA[sendUDP]]></Name>
					<X>50</X><Y>30</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[try (DatagramSocket socket = new DatagramSocket()) {
  byte[] buf = json.getBytes(StandardCharsets.UTF_8);
  InetAddress addr = InetAddress.getByName("127.0.0.1");
  DatagramPacket packet = new DatagramPacket(buf, buf.length, addr, 9876);
  socket.send(packet);
} catch(Exception e){
  traceln("UDP send error: " + e);
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1757623693439</Id>
					<Name><![CDATA[sendTelemetry]]></Name>
					<X>140</X><Y>30</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double[] _wx = (double[]) wx;
double[] _wy = (double[]) wy;
double tx = (wpIdx >= 0 && wpIdx < _wx.length) ? _wx[wpIdx] : x;
double ty = (wpIdx >= 0 && wpIdx < _wy.length) ? _wy[wpIdx] : y;
boolean reached = Math.hypot(tx - x, ty - y) <= tol;

// fallback per agv_id
String id = (agvId != null && !agvId.isEmpty()) ? agvId : "AGV_1";

String json = String.format(
  "{\"bridge_meta\":{\"protocol\":\"udp\"},\"source\":\"anylogic\",\"status\":\"working\","
+ "\"output\":{\"status\":\"ok\",\"sim_time\":%.3f,\"agv_id\":\"%s\","
+ "\"pose\":{\"x\":%.3f,\"y\":%.3f,\"theta\":%.6f},\"v\":%.6f,\"battery_soc\":%.6f,"
+ "\"target\":{\"x\":%.3f,\"y\":%.3f},\"reached_waypoint\":%s}}",
  time(), id, x, y, theta, v, soc, tx, ty, reached ? "true" : "false"
);
sendUDP(json);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1757624623137</Id>
					<Name><![CDATA[sendInputTarget]]></Name>
					<X>50</X><Y>440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ty]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tx]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// JSON di input per MATLAB (il tuo client lo inoltrerà al bridge)
String json = String.format(
  "{\"type\":\"SIM_INPUT\",\"inputs\":{\"target\":{\"x\":%.6f,\"y\":%.6f}}}",
  tx, ty
);
sendUDP(json);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1757624674875</Id>
					<Name><![CDATA[sendInputSpeedCap]]></Name>
					<X>50</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
